# ===== Aplikasi =====
# Port di sisi VPS (container tetap 3000)
HOST_PORT=3000
# 127.0.0.1 = hanya lewat Nginx (disarankan) | 0.0.0.0 = bisa diakses langsung via http://IP-VPS:HOST_PORT
HOST_BIND=127.0.0.1

# Login halaman (Basic Auth). WAJIB diisi kalau app bisa diakses dari internet.
APP_USERNAME=admin
APP_PASSWORD=ganti-password-ini

# Hapus riwayat & file hasil yang lebih tua dari N hari
JOB_RETENTION_DAYS=30

# ===== Asta Document Services =====
ASTA_API_URL=https://temp.astakorpora.com/api/v1/generate
# Template default (masih bisa diganti dari halaman)
ASTA_TEMPLATE_ID=
# Kalau Asta butuh API key. Contoh: ASTA_AUTH_HEADER=Authorization, ASTA_API_KEY=Bearer xxxxx
#                         atau:    ASTA_AUTH_HEADER=x-api-key,     ASTA_API_KEY=xxxxx
ASTA_AUTH_HEADER=Authorization
ASTA_API_KEY=
ASTA_TIMEOUT_MS=60000
# Berapa DT dikirim bersamaan
ASTA_CONCURRENCY=2
# Kalau Asta mengembalikan URL file: true = file diunduh & disimpan di server ini
ASTA_DOWNLOAD_RESULT=true

# ===== Callback (hanya bila Asta memproses async lalu POST hasilnya balik) =====
# URL publik app ini, mis. https://dt.astakorpora.com  (kosongkan bila tidak pakai callback)
PUBLIC_BASE_URL=
# Nama field di payload untuk URL callback, mis. callback_url (kosong = tidak dikirim)
ASTA_CALLBACK_FIELD=
# Token rahasia yang ikut di URL callback (?token=...)
CALLBACK_SECRET=
